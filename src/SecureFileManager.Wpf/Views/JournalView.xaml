<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.JournalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,6"><Button Content="Обновить / применить" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Padding="9,4" MinHeight="32"/><TextBlock Text="{Binding Status.Text}" ToolTip="{Binding Status.Evidence}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/></DockPanel>
 <Expander Grid.Row="1" Header="Фильтры и поиск" Margin="0,0,0,8"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="80"><StackPanel>
 <WrapPanel>
 <StackPanel Width="140" Margin="0,0,8,4"><TextBlock Text="Дата с" Style="{StaticResource LabelText}"/><DatePicker SelectedDate="{Binding FromDate}" Height="34" AutomationProperties.Name="Начальная дата событий"/></StackPanel>
 <StackPanel Width="140" Margin="0,0,8,4"><TextBlock Text="По дату включительно" Style="{StaticResource LabelText}"/><DatePicker SelectedDate="{Binding UntilDate}" Height="34" AutomationProperties.Name="Конечная дата событий"/></StackPanel>
 <StackPanel Width="180" Margin="0,0,8,4"><TextBlock Text="Операция" Style="{StaticResource LabelText}"/><ComboBox ItemsSource="{Binding ActionFilters}" SelectedIndex="{Binding ActionIndex}" AutomationProperties.Name="Фильтр операций"/></StackPanel>
 <StackPanel Width="150" Margin="0,0,8,4"><TextBlock Text="Результат" Style="{StaticResource LabelText}"/><ComboBox ItemsSource="{Binding ResultFilters}" SelectedIndex="{Binding ResultIndex}" AutomationProperties.Name="Фильтр результатов"/></StackPanel>
 </WrapPanel>
 <WrapPanel><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Width="230" ToolTip="Поиск по относительному имени / пути объекта; до 200 символов" AutomationProperties.Name="Поиск в журнале" Margin="0,0,8,4"/>
 <CheckBox Content="Сначала новые" IsChecked="{Binding Descending}" VerticalAlignment="Center" Margin="0,0,8,4"/><Button Content="Сбросить" Command="{Binding ResetCommand}" Margin="0,0,8,4"/></WrapPanel>
 </StackPanel></ScrollViewer></Expander>
 <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding Items}" CanUserSortColumns="False" IsReadOnly="True" RowHeight="NaN" MinRowHeight="48" AutomationProperties.Name="Журнал текущего пользователя"><DataGrid.Columns>
 <DataGridTextColumn Header="Дата и время" Binding="{Binding OccurredAt}" Width="180"/><DataGridTextColumn Header="Пользователь" Binding="{Binding Actor}" Width="145"/>
 <DataGridTextColumn Header="Операция" Binding="{Binding Action}" Width="190"/><DataGridTextColumn Header="Объект" Binding="{Binding Target}" Width="180"/>
 <DataGridTemplateColumn Header="Результат" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Result}" Tag="{Binding ResultCode}" Style="{StaticResource StatusBadge}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="Описание" Width="340" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" ToolTip="{Binding Description}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid>
 <Border Margin="0,40,0,0" Background="{DynamicResource Brush.Paper50}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 </Grid>
 <WrapPanel Grid.Row="3" Margin="0,8,0,0"><Button Content="Назад" Command="{Binding PreviousCommand}" MinHeight="30" Padding="9,3" Margin="0,0,8,0"/><Button Content="Далее" Command="{Binding NextCommand}" MinHeight="30" Padding="9,3" Margin="0,0,8,0"/><TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/></WrapPanel>
</Grid></UserControl>
