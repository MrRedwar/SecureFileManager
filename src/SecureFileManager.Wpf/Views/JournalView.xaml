<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.JournalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <WrapPanel Margin="0,0,0,16">
 <StackPanel Width="160" Margin="0,0,12,8"><TextBlock Text="Дата" Style="{StaticResource LabelText}"/><DatePicker IsEnabled="False" Height="40" ToolTip="Фильтры будут подключены на этапе 08." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Дата событий"/></StackPanel>
 <StackPanel Width="190" Margin="0,0,12,8"><TextBlock Text="Операция" Style="{StaticResource LabelText}"/><ComboBox ItemsSource="{Binding ActionFilters}" SelectedIndex="0" IsEnabled="False" ToolTip="Журнал ещё не подключён." AutomationProperties.Name="Фильтр операций"/></StackPanel>
 <StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="Результат" Style="{StaticResource LabelText}"/><ComboBox ItemsSource="{Binding ResultFilters}" SelectedIndex="0" IsEnabled="False" ToolTip="Журнал ещё не подключён." AutomationProperties.Name="Фильтр результатов"/></StackPanel>
 </WrapPanel>
 <Grid Grid.Row="1"><DataGrid ItemsSource="{Binding Items}" AutomationProperties.Name="Журнал текущего пользователя"><DataGrid.Columns>
 <DataGridTextColumn Header="Дата и время" Binding="{Binding OccurredAt}" Width="170"/><DataGridTextColumn Header="Пользователь" Binding="{Binding Actor}" Width="140"/><DataGridTextColumn Header="Операция" Binding="{Binding Action}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Объект" Binding="{Binding Target}" Width="160"/>
 <DataGridTemplateColumn Header="Результат" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Result}" Style="{StaticResource StatusBadge}"><TextBlock.Tag><Binding Path="ResultCode"/></TextBlock.Tag></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid><ScrollViewer Margin="0,44,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionState}"/></ScrollViewer></Grid>
 <WrapPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="Обозначения результатов: " Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Успех" Tag="Success" Style="{StaticResource StatusBadge}" Margin="0,0,8,0"/><TextBlock Text="Отказано" Tag="Denied" Style="{StaticResource StatusBadge}" Margin="0,0,8,0"/><TextBlock Text="Ошибка" Tag="Failed" Style="{StaticResource StatusBadge}"/></WrapPanel>
</Grid></UserControl>