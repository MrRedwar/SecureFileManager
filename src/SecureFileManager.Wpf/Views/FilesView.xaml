<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.FilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
 <WrapPanel Grid.Row="1" Margin="0,0,0,12">
 <Button AutomationProperties.Name="Создать" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Create}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Создать" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Открыть" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" ><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Files}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Открыть" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Удалить" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" ><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Delete}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Удалить" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Архивировать" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" ><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Archives}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Архивировать" VerticalAlignment="Center"/></StackPanel></Button>
 <Grid Width="230" Height="40" Margin="0,0,0,8"><TextBox Text="Поиск файлов и папок…" IsEnabled="False" Padding="38,8,10,8" ToolTip="Поиск будет доступен на этапе 05." AutomationProperties.Name="Поиск файлов и папок"/><Image Source="{StaticResource Icon.Search}" Width="20" Height="20" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/></Grid>
 </WrapPanel>
 <Grid Grid.Row="2">
 <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedFile}" AutomationProperties.Name="Файлы пользователя">
 <DataGrid.Columns>
  <DataGridTemplateColumn Header="Имя" Width="*" MinWidth="180" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="150"/>
  <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="100"/>
  <DataGridTextColumn Header="Дата изменения" Binding="{Binding ModifiedAt}" Width="170"/>
 </DataGrid.Columns></DataGrid>
 <ScrollViewer Margin="0,44,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionState}"/></ScrollViewer>
 </Grid>
 <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Style="{StaticResource MutedText}"><Run Text="Элементов: "/><Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text="   ·   Выбрано: "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/></TextBlock><TextBlock Text="Вход не выполнен · содержимое не загружено" Style="{StaticResource MutedText}" TextAlignment="Right"/></DockPanel>
</Grid></UserControl>