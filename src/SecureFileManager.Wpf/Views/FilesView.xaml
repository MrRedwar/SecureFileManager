<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.FilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources><Style x:Key="FileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,6,6"/></Style><Style x:Key="FilePrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,6,6"/></Style></UserControl.Resources><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="К корню" Command="{Binding RootCommand}" Style="{StaticResource FileButton}"/><Button Content="Вверх" Command="{Binding ParentCommand}" Style="{StaticResource FileButton}"/><Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource FileButton}"/><Button Content="Сверить" Command="{Binding SynchronizeCommand}" Style="{StaticResource FileButton}" ToolTip="Явно согласовать выбранный объект с БД; физические файлы не удаляются"/><Button Content="Восстановить" Command="{Binding RecoverCommand}" Style="{StaticResource FileButton}" ToolTip="Проверить и восстановить незавершённые операции"/></StackPanel><TextBlock Text="{Binding Breadcrumb}" ToolTip="{Binding Breadcrumb}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
 <WrapPanel Grid.Row="1" Margin="0,0,0,8">
 <Button Content="Создать файл" ToolTip="TXT, JSON или XML; укажите расширение в имени" Command="{Binding CreateFileCommand}" Style="{StaticResource FilePrimary}"/>
 <Button Style="{StaticResource FileButton}" Content="Создать папку" Command="{Binding CreateFolderCommand}"/>
 <Button Style="{StaticResource FileButton}" Command="{Binding OpenCommand}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Files}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Открыть"/></StackPanel></Button>
 <Button Style="{StaticResource FileButton}" Command="{Binding DeleteCommand}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Delete}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Удалить"/></StackPanel></Button>
 <Button Style="{StaticResource FileButton}" Content="Импортировать" Command="{Binding ImportCommand}" ToolTip="Копия выбранного файла в эту папку; до 100 МиБ"/>
 <Button Style="{StaticResource FileButton}" Command="{Binding UnavailableCommand}" ToolTip="ZIP относится к этапу 07."><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Archives}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Архивировать"/></StackPanel></Button>
 </WrapPanel>
 <StackPanel Grid.Row="2" Margin="0,0,0,12">
  <WrapPanel><Grid Width="230" Height="40" Margin="0,0,12,8"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,8,10,8" ToolTip="Поиск по имени в текущей папке" AutomationProperties.Name="Поиск файлов и папок"/><Image Source="{StaticResource Icon.Search}" Width="20" Height="20" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/></Grid>
  <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" Width="170" Height="40" Margin="0,0,12,8" AutomationProperties.Name="Сортировка"/><CheckBox Content="По убыванию" IsChecked="{Binding Descending}" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
  <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"/>
  <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0"/>
 </StackPanel>
 <Grid Grid.Row="3">
 <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding SelectedFile}" MouseDoubleClick="OpenDoubleClick" AutomationProperties.Name="Файлы пользователя" EnableRowVirtualization="True">
 <DataGrid.Columns>
  <DataGridTemplateColumn Header="Имя" Width="*" MinWidth="160" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="110" SortMemberPath="Type"/>
  <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="90" SortMemberPath="SizeBytes"/>
  <DataGridTextColumn Header="Дата изменения" Binding="{Binding ModifiedAt}" Width="155" SortMemberPath="ModifiedUtc"/>
  <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="160"/>
 </DataGrid.Columns></DataGrid>
 <TextBlock Text="{Binding EmptyText}" Margin="12,44,12,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CardHeading}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding View.IsEmpty}" Value="True"/><Condition Binding="{Binding IsLoading}" Value="False"/><Condition Binding="{Binding ErrorMessage}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid>
 <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" Margin="0,12,0,0"><Run Text="Всего объектов: "/><Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text=" · Выбрано: "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" · Поиск ограничен текущей папкой"/></TextBlock>
</Grid></UserControl>
