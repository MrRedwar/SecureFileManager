<Window x:Class="SecureFileManager.Wpf.Views.AuthenticationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Secure File Manager — вход" Width="640" Height="760" MinWidth="520" MinHeight="600"
 WindowStartupLocation="CenterScreen" Language="ru-RU">
 <Grid><Grid.RowDefinitions><RowDefinition Height="156"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Background="{DynamicResource Brush.Stone}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
 <Image Source="{StaticResource Icon.Eye}" Width="72" Height="54" Stretch="Uniform" AutomationProperties.Name="Око Гора"/>
 <TextBlock Text="SECURE FILE MANAGER" FontFamily="Georgia" FontSize="23" Foreground="{DynamicResource Brush.Gold200}" Margin="0,10,0,10" TextAlignment="Center"/>
 <Image Source="{StaticResource Art.Header}" Width="310" Height="32" Stretch="Uniform" IsHitTestVisible="False"/>
 </StackPanel></Grid>
 <Border Grid.Row="1" Background="{DynamicResource Brush.Sand100}"><Grid Background="{DynamicResource Brush.Papyrus}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" Margin="24,24,24,12"/>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding Page}" HorizontalContentAlignment="Stretch"/></ScrollViewer>
 </Grid></Border>
 <Border Grid.Row="2" Background="{DynamicResource Brush.Sand100}" BorderBrush="{DynamicResource Brush.Gold200}" BorderThickness="0,1,0,0" Padding="24,14">
 <StackPanel><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Повторить" Command="{Binding RetryConnectionCommand}" Margin="12,0,0,0"/><TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 <WrapPanel HorizontalAlignment="Center"><Button Content="Вход" Command="{Binding ShowLoginCommand}" Margin="0,0,8,0"/><Button Content="Создать учётную запись" Command="{Binding ShowRegisterCommand}" Margin="0"/></WrapPanel>
 <Image Source="{StaticResource Art.Footer}" Width="240" Height="30" Margin="0,12,0,0" Stretch="Uniform" IsHitTestVisible="False"/></StackPanel>
 </Border></Grid>
</Window>
