<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.Eye}" Width="44" Height="44" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Secure File Manager" Style="{StaticResource CardHeading}"/><TextBlock Text="Локальное управление собственными файлами" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="{Binding Version, StringFormat=Версия сборки: {0}}" Margin="0,12,0,0"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.User}" Width="36" Height="36" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Текущий пользователь" Style="{StaticResource CardHeading}"/><TextBlock Text="{Binding SessionStatus}" Margin="0,12,0,6"/><TextBlock Text="{Binding StorageStatus, StringFormat=Рабочая область: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="Сеанс хранится в памяти. Для смены пользователя нажмите «Выйти»." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.Database}" Width="36" Height="36" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="База данных" Style="{StaticResource CardHeading}"/><TextBlock Text="{Binding DatabaseStatus}" Margin="0,12,0,6" TextWrapping="Wrap"/><TextBlock Text="Статус относится к последнему входу. При сбое обязательного аудита новые действия блокируются." Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.Security}" Width="36" Height="36" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Политика безопасности проекта" Style="{StaticResource CardHeading}"/><TextBlock Text="Изолированное хранилище · проверка владельца · безопасные JSON/XML и ZIP · аудит действий" TextWrapping="Wrap" Margin="0,12,0,6"/><TextBlock Text="Перечислены требования проекта, а не подтверждение реализации всех механизмов. Пароли, сессии и граница личного хранилища реализованы. Файловые операции, JSON/XML и ZIP относятся к следующим этапам." Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
</StackPanel></ScrollViewer></UserControl>