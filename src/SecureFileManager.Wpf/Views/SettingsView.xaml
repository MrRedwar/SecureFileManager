<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.Eye}" Width="44" Height="44" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Secure File Manager" Style="{StaticResource CardHeading}"/><TextBlock Text="Локальное управление собственными файлами" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="{Binding Version, StringFormat=Версия сборки: {0}}" Margin="0,12,0,0"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.User}" Width="36" Height="36" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Текущий пользователь" Style="{StaticResource CardHeading}"/><TextBlock Text="{Binding SessionStatus}" Margin="0,12,0,6"/><TextBlock Text="{Binding StorageStatus, StringFormat=Рабочая область: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="Сеанс хранится в памяти. Для смены пользователя нажмите «Выйти»." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.Database}" Width="36" Height="36" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="База данных" Style="{StaticResource CardHeading}"/><TextBlock Text="{Binding Status.Text}" Margin="0,12,0,6" TextWrapping="Wrap"/><TextBlock Text="{Binding Status.Evidence}" Style="{StaticResource MutedText}"/><Button Content="Проверить журнал" Command="{Binding CheckCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource Icon.Security}" Width="36" Height="36" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Политика безопасности проекта" Style="{StaticResource CardHeading}"/><TextBlock Text="Изолированное хранилище · проверка владельца · безопасные JSON/XML и ZIP · аудит действий" TextWrapping="Wrap" Margin="0,12,0,6"/><TextBlock Text="TXT/JSON/XML — до 10 МиБ UTF-8; DTD запрещены. ZIP: 250 записей, 25 МиБ на файл, 100 МиБ всего, 100:1. Программная изоляция не защищает от прямого доступа владельца Windows или администратора к диску и SQL." Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Диагностика согласованности" Style="{StaticResource CardHeading}"/><TextBlock Text="Проверка по запросу, без исправления данных. До 10000 объектов; содержимое файлов с БД не сравнивается. Сверку и восстановление выполняйте отдельно после разбора замечаний." Style="{StaticResource MutedText}" Margin="0,8,0,8"/><Button Content="Проверить хранилище без исправлений" Command="{Binding DiagnoseCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding DiagnosisStatus}" TextWrapping="Wrap" Margin="0,8,0,8"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
 <DataGrid ItemsSource="{Binding Issues}" Height="180" AutomationProperties.Name="Результаты диагностики хранилища"><DataGrid.Columns><DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="190"/><DataGridTextColumn Header="Относительный путь" Binding="{Binding Path}" Width="220"/><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="360"/></DataGrid.Columns></DataGrid></StackPanel></Border>
</StackPanel></ScrollViewer></UserControl>
