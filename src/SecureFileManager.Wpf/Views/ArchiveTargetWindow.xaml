<Window x:Class="SecureFileManager.Wpf.Views.ArchiveTargetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Background="{DynamicResource Brush.Sand100}" Title="Назначение ZIP-операции" Width="740" Height="600" MinWidth="600" MinHeight="440" WindowStartupLocation="CenterOwner">
 <Grid Margin="20" Background="{DynamicResource Brush.Sand100}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <StackPanel Grid.Row="1" DataContext="{Binding Browser}"><TextBlock Text="{Binding Breadcrumb}" TextWrapping="Wrap"/>
   <WrapPanel><Button Content="К корню" Command="{Binding RootCommand}"/><Button Content="Вверх" Command="{Binding ParentCommand}"/><Button Content="Обновить" Command="{Binding RefreshCommand}"/></WrapPanel>
   <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid Grid.Row="2" DataContext="{Binding Browser}" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedFile}" MouseDoubleClick="OpenFolder" AutomationProperties.Name="Папки личного хранилища">
   <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenCommand}"/></DataGrid.InputBindings>
   <DataGrid.Columns><DataGridTextColumn Header="Папка (Enter или двойной щелчок — перейти)" Binding="{Binding Name}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Имя ZIP или новой папки результата"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Имя результата ZIP-операции"/></StackPanel>
  <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Отмена" IsCancel="True"/><Button Content="Выбрать текущую папку" IsEnabled="{Binding CanAccept}" Click="Accept" Style="{StaticResource PrimaryButton}" ToolTip="Доступно после успешной загрузки папок при действующем сеансе; имя и разрешения будут повторно проверены сервисом"/></WrapPanel>
 </Grid>
</Window>
