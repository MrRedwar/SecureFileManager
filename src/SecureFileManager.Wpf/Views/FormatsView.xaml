<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.FormatsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"><DockPanel><Image Source="{StaticResource Icon.JsonXml}" Width="28" Height="28" Margin="0,0,12,0"/><TextBlock Text="{Binding FileLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel></Border>
 <WrapPanel Grid.Row="1" Margin="0,0,0,8"><Button AutomationProperties.Name="Выбрать файл" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Files}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Выбрать файл" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Проверить формат" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" ><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.JsonXml}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Проверить формат" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Сохранить" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" ><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Create}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Сохранить" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel>
 <Grid Grid.Row="2"><TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Содержимое документа" ToolTip="Редактор и обработка форматов будут доступны на этапе 06."/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionState}"/></ScrollViewer></Grid>
 <TextBlock Grid.Row="3" Text="Документ не открыт · проверка формата не выполнялась" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
</Grid></UserControl>