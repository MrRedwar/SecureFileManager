<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.ArchivesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <WrapPanel><Button AutomationProperties.Name="Создать архив" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Create}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Создать архив" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Просмотреть" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" ><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Archives}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Просмотреть" VerticalAlignment="Center"/></StackPanel></Button><Button AutomationProperties.Name="Распаковать" Command="{Binding UnavailableCommand}" ToolTip="{Binding UnavailableReason}" ><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Files}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Распаковать" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel>
 <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,16" Padding="14"><TextBlock Text="Проектные лимиты ZIP: до 250 записей · 25 МиБ на файл · 100 МиБ суммарно · коэффициент до 100:1. Проверки и распаковка будут реализованы на этапе 07." Style="{StaticResource MutedText}"/></Border>
 <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding Items}" AutomationProperties.Name="Архивы пользователя"><DataGrid.Columns><DataGridTextColumn Header="Имя архива" Binding="{Binding Name}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="120"/><DataGridTextColumn Header="Дата изменения" Binding="{Binding ModifiedAt}" Width="180"/></DataGrid.Columns></DataGrid><ScrollViewer Margin="0,44,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionState}"/></ScrollViewer></Grid>
 <TextBlock Grid.Row="3" Text="{Binding Items.Count, StringFormat=Архивов: {0}}" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
</Grid></UserControl>