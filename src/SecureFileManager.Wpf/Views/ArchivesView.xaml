<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.ArchivesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SecureFileManager.Wpf.Views">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="ZIP: 250 записей · 25 МиБ/файл · 100 МиБ всего · 100:1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <TabControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="1" Background="{DynamicResource Brush.Sand100}">
   <TabItem Header="ZIP-архивы"><views:FilesView DataContext="{Binding Browser}" Margin="4"/></TabItem>
   <TabItem Header="Создать архив: выбрать файлы"><views:FilesView DataContext="{Binding Sources}" Margin="4"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
