<UserControl x:Class="SecureFileManager.Wpf.Views.RegisterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
<StackPanel MaxWidth="440" Margin="24,12">
 <TextBlock Text="Создайте личное пространство для своих файлов." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
 <TextBlock Text="Логин" Style="{StaticResource LabelText}"/>
 <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" IsEnabled="{Binding CanSubmit}" AutomationProperties.Name="Логин" Margin="0,0,0,18" TabIndex="0"/>
 <TextBlock Text="Пароль · 10–128 символов" Style="{StaticResource LabelText}"/>
 <PasswordBox x:Name="Password" MaxLength="128" IsEnabled="{Binding CanSubmit}" AutomationProperties.Name="Пароль" Margin="0,0,0,18" TabIndex="1"/>
 <TextBlock Text="Подтверждение пароля" Style="{StaticResource LabelText}"/><PasswordBox x:Name="Confirmation" MaxLength="128" IsEnabled="{Binding CanSubmit}" AutomationProperties.Name="Подтверждение пароля" Margin="0,0,0,18" TabIndex="2"/>
 <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MinHeight="24" Margin="0,0,0,14"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsError}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="{Binding CanSubmit}" Click="Submit" Margin="0,0,0,16" AutomationProperties.Name="Зарегистрироваться"/>
 <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource Brush.Teal600}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
 <TextBlock Text="Пароль хранится только как хеш. Регистрация не выполняет автоматический вход." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,18,0,0"/>
</StackPanel></UserControl>