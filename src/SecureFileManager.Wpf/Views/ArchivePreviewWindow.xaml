<Window x:Class="SecureFileManager.Wpf.Views.ArchivePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Background="{DynamicResource Brush.Sand100}" Title="Содержимое ZIP" Width="900" Height="620" MinWidth="600" MinHeight="440" WindowStartupLocation="CenterOwner">
 <Grid Margin="20" Background="{DynamicResource Brush.Sand100}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <StackPanel Grid.Row="1"><TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"/>
   <TextBlock Text="Предпросмотр не извлекает файлы. Записи с предупреждениями блокируют распаковку целиком." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
  </StackPanel>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" AutomationProperties.Name="Содержимое ZIP-архива"><DataGrid.Columns>
   <DataGridTextColumn Header="Путь в ZIP" Binding="{Binding Path}" Width="*" MinWidth="180"/>
   <DataGridTextColumn Header="Заявлено" Binding="{Binding SizeLabel}" Width="100"/>
   <DataGridTextColumn Header="Сжато" Binding="{Binding CompressedLabel}" Width="100"/>
   <DataGridTextColumn Header="Предупреждение" Binding="{Binding Warning}" Width="240"/>
  </DataGrid.Columns></DataGrid>
  <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Закрыть" IsCancel="True"/><Button x:Name="ContinueButton" Content="Далее: выбрать назначение" IsEnabled="{Binding CanExtract}" Click="Accept" Style="{StaticResource PrimaryButton}" ToolTip="Доступно только если предварительная проверка не обнаружила нарушений; при распаковке будут проверены фактические байты"/></WrapPanel>
 </Grid>
</Window>
