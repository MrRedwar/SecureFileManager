<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="SecureFileManager.Wpf.Views.DrivesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}"/><TextBlock Text="Характеристики накопителей. Доступ к произвольным каталогам не предоставляется." Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,8"/><ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
 <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Image Source="{StaticResource Icon.Drives}" Width="46" Height="46" VerticalAlignment="Top"/>
 <StackPanel Grid.Column="1"><WrapPanel><TextBlock Text="{Binding Name}" Style="{StaticResource CardHeading}" Margin="0,0,16,0"/><TextBlock Text="{Binding Label}" Style="{StaticResource CardHeading}"/></WrapPanel><TextBlock Text="{Binding State}" Margin="0,6,0,10"/>
 <WrapPanel><TextBlock Text="{Binding Type}" Margin="0,0,16,8"/><TextBlock Text="{Binding Format}" Margin="0,0,16,8"/><TextBlock Text="{Binding Total, StringFormat=Всего: {0}}" Margin="0,0,16,8"/><TextBlock Text="{Binding Free, StringFormat=Свободно: {0}}" Margin="0,0,16,8"/><TextBlock Text="{Binding Used, StringFormat=Занято: {0}}" Margin="0,0,16,8"/></WrapPanel>
 <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="7" Minimum="0" Maximum="100" Foreground="{DynamicResource Brush.Teal600}" Background="{DynamicResource Brush.Sand100}"/><TextBlock Text="{Binding Percent, StringFormat=Заполнено: {0:F1}%}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
 </StackPanel></Grid></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="Нет загруженных накопителей."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel></ScrollViewer>
</Grid></UserControl>
