<Window x:Class="SecureFileManager.Wpf.Views.TextEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:files="clr-namespace:SecureFileManager.Core.Files;assembly=SecureFileManager.Core"
 Style="{StaticResource {x:Type Window}}" Background="{DynamicResource Brush.Sand100}" Title="{Binding Title}" Width="860" Height="660" MinWidth="600" MinHeight="440">
 <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/></Window.InputBindings>
 <Grid Margin="24" Background="{DynamicResource Brush.Sand100}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding FormatLabel}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DirtyLabel}" Style="{StaticResource MutedText}"/></StackPanel>
 <WrapPanel Grid.Row="1"><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" ToolTip="Доступно после изменения текста при действующем сеансе; Ctrl+S"/><Button Content="Проверить" Command="{Binding ValidateCommand}" ToolTip="Проверка JSON/XML при действующем сеансе; TXT не требует проверки структуры"/><Button Content="Перечитать" Command="{Binding ReloadCommand}" ToolTip="Загрузить файл с диска после подтверждения; доступно при действующем сеансе"/></WrapPanel>
 <TextBox Grid.Row="2" MaxLength="{x:Static files:FileRules.TextLimit}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsUsable}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="14" UndoLimit="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Содержимое документа"/>
 <ScrollViewer Grid.Row="3" MaxHeight="120" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,12,0,0"/></ScrollViewer>
 </Grid>
</Window>
