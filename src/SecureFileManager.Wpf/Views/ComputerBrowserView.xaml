<UserControl x:Class="SecureFileManager.Wpf.Views.ComputerBrowserView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type UserControl}}">
 <UserControl.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,8">
   <Button Content="Этот компьютер" Command="{Binding ComputerCommand}" Margin="0,0,6,6"/>
   <Button Content="Вверх" Command="{Binding ParentCommand}" Margin="0,0,6,6"/>
   <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,6,6"/>
   <Button Content="Открыть" Command="{Binding OpenCommand}" Margin="0,0,6,6" ToolTip="Открыть папку или TXT/JSON/XML в редакторе"/>
   <Button Content="Восстановить" Command="{Binding RecoverCommand}" Margin="0,0,6,6" ToolTip="Проверить незавершённое сохранение выбранного внешнего файла по SQL и резервной копии"/>
   <Menu Margin="0,0,6,6" Background="{DynamicResource Brush.Sand100}" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" AutomationProperties.Name="Действия с файлами компьютера">
    <MenuItem Header="Действия">
     <MenuItem Header="Создать файл" Command="{Binding CreateFileCommand}"/>
     <MenuItem Header="Создать папку" Command="{Binding CreateFolderCommand}"/>
     <Separator/>
     <MenuItem Header="Копировать в…" Command="{Binding CopyCommand}"/>
     <MenuItem Header="Переместить в…" Command="{Binding MoveCommand}"/>
     <MenuItem Header="Переименовать" Command="{Binding RenameCommand}"/>
     <Separator/>
     <MenuItem Header="Проверить операции" Command="{Binding RecoverOperationsCommand}" ToolTip="Восстановление по сохранённым планам и SQL; неизвестные данные не удаляются"/>
    </MenuItem>
   </Menu>
  </WrapPanel>
  <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь к папке компьютера" ToolTip="Абсолютный локальный путь, например C:\Users; пустая строка — список дисков">
    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GoCommand}"/></TextBox.InputBindings>
   </TextBox>
   <Button Grid.Column="1" Content="Перейти" Command="{Binding GoCommand}" Margin="8,0,0,0"/>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,0,0,8">
   <TextBlock Text="Общие файлы по правам Windows. TXT, JSON и XML открываются в редакторе." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
   <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск в папке компьютера" ToolTip="Поиск по имени среди загруженных объектов" MaxWidth="320" HorizontalAlignment="Left" MinWidth="200"/>
   <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"/>
  </StackPanel>
  <DataGrid Grid.Row="3" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" MouseDoubleClick="OpenFolder" EnableRowVirtualization="True" AutomationProperties.Name="Файлы компьютера">
   <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenCommand}"/></DataGrid.InputBindings>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
    <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" SortMemberPath="Data.IsDirectory" Width="115"/>
    <DataGridTextColumn Header="Размер" Binding="{Binding Size}" SortMemberPath="Data.SizeBytes" Width="100"/>
    <DataGridTextColumn Header="Изменён" Binding="{Binding Modified}" SortMemberPath="Data.ModifiedUtc" Width="170"/>
    <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="260"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </Grid>
</UserControl>
