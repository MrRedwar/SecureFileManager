<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- SDK 9 dotnet run uses this; Visual Studio uses the launch profile workingDirectory. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**\*.png" />
    <Resource Include="Assets\**\*.png" />
    <ProjectReference Include="..\SecureFileManager.Core\SecureFileManager.Core.csproj" />
    <ProjectReference Include="..\SecureFileManager.Data\SecureFileManager.Data.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.22" />
    <None Remove="appsettings.Development.json;appsettings.Development.local.json;appsettings.local.json" />
  </ItemGroup>
</Project>
