<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<Style x:Key="NavigationItem" TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
 <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,2"/>
 <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnDark}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
 <Border x:Name="Surface" Background="Transparent" CornerRadius="4"><Grid><Border x:Name="Marker" BorderThickness="3,0,0,0" BorderBrush="Transparent"/><Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"/><ContentPresenter Margin="{TemplateBinding Padding}"/></Grid></Border>
 <ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Navy800}"/></Trigger>
 <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Teal600}"/><Setter TargetName="Marker" Property="BorderBrush" Value="{DynamicResource Brush.Gold200}"/></Trigger>
 <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Brush.TextOnDark}"/></Trigger>
 </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
</ResourceDictionary>