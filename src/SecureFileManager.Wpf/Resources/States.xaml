<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<DataTemplate x:Key="SectionState">
 <Grid x:Name="StateRoot" Margin="28" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
  <StackPanel x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center">
   <Image x:Name="StateIcon" Source="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="64" Height="64" Stretch="Uniform" Opacity="0.8"/>
   <TextBlock x:Name="StateTitle" Text="Данные ещё не загружены" FontFamily="Georgia" FontSize="22" TextAlignment="Center" Margin="0,18,0,8"/>
   
   <TextBlock Text="Действия пока недоступны. Данные появятся после подключения раздела." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0"/>
  </StackPanel>
  <Border x:Name="Error" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1" Padding="18" CornerRadius="6" Background="{DynamicResource Brush.Paper50}">
   <StackPanel><TextBlock Text="Не удалось загрузить данные" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  </Border>
  <StackPanel x:Name="Loading" Visibility="Collapsed"><ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource Brush.Teal600}"/><TextBlock Text="Загрузка…" Margin="0,12,0,0" TextAlignment="Center"/></StackPanel>
 </Grid>
 <DataTemplate.Triggers>
  <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter TargetName="Empty" Property="Visibility" Value="Visible"/><Setter TargetName="Error" Property="Visibility" Value="Collapsed"/></DataTrigger>
  <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter TargetName="Empty" Property="Visibility" Value="Collapsed"/><Setter TargetName="Error" Property="Visibility" Value="Collapsed"/><Setter TargetName="Loading" Property="Visibility" Value="Visible"/></DataTrigger>
 <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BelowThreshold}, ConverterParameter=700}" Value="True"><Setter TargetName="StateIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="StateRoot" Property="Margin" Value="16"/><Setter TargetName="StateTitle" Property="Margin" Value="0,8,0,8"/></DataTrigger></DataTemplate.Triggers>
</DataTemplate>
</ResourceDictionary>