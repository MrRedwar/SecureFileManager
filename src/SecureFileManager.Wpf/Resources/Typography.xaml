<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<Style TargetType="Window">
 <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
 <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Background" Value="{DynamicResource Brush.Navy900}"/>
 <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
</Style>
<Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="30"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/></Style>
<Style x:Key="CardHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
<Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Margin" Value="0,0,0,6"/></Style>
<Style TargetType="UserControl"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/></Style>
</ResourceDictionary>